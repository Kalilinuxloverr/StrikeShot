    "alert.danger.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschlag nur %@ entfernt. 30/30-Regel: Sind zwischen Blitz und Donner weniger als 30 Sekunden, such Schutz und bleib danach 30 Minuten drinnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strike only %@ away. The 30/30 rule: if flash to thunder is under 30 seconds, take shelter and stay inside for 30 minutes afterwards."
          }
        }
      }
    },
    "alert.danger.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
